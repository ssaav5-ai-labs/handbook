{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "gateway": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LLM gateway",
      "options": { "baseURL": "{env:LLM_GATEWAY_URL}/v1", "apiKey": "{env:LLM_GATEWAY_KEY}" },
      "models": {
        "fast":   { "name": "fast",   "limit": { "context": 200000, "output": 8000 } },
        "code":   { "name": "code",   "limit": { "context": 200000, "output": 8000 } },
        "reason": { "name": "reason", "limit": { "context": 200000, "output": 8000 } }
      }
    }
  },
  "model": "gateway/code",
  "permission": {
    "bash": {
      "*": "allow",
      "rm *": "ask",
      "git push": "ask",
      "git push *": "ask",
      "git reset *": "ask",
      "git clean *": "ask",
      "sudo *": "ask",
      "docker *": "ask",
      "cat *.env*": "deny",
      "cat *tfvars*": "deny",
      "cat *kube/config*": "deny",
      "cat *keys.txt*": "deny",
      "cat *sops-age*": "deny",
      "sops decrypt *": "deny",
      "sops -d *": "deny",
      "sops --decrypt *": "deny",
      "kubectl get secret *": "ask",
      "kubectl get secrets *": "ask",
      "kubectl * get secret *": "ask",
      "kubectl * get secrets *": "ask",
      "env": "deny",
      "printenv": "deny",
      "printenv *": "deny"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.tfvars": "deny",
      "*/.kube/config": "deny",
      "*/k3s.yaml": "deny",
      "*keys.txt": "deny",
      "*/.sops-age/*": "deny"
    }
  },
  "mcp": {
    "open-knowledge": {
      "type": "local",
      "enabled": true,
      "command": ["ok", "mcp"]
    }
  }
}
